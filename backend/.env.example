# ============================================================
#  Shahzod Web Studio — Backend environment
#  Copy to `.env` and fill in your real values.
#  NEVER commit the real `.env` file to Git.
# ============================================================

# Port the backend listens on
PORT=4000
NODE_ENV=development

# ------------------------------------------------------------
# Database — PostgreSQL
# Set DB_TYPE=postgres and DATABASE_URL to use PostgreSQL.
# If left as "auto" (default): uses PostgreSQL when DATABASE_URL
# is set, otherwise falls back to an in-memory database (good for
# quick local testing without installing PostgreSQL).
# ------------------------------------------------------------
DB_TYPE=auto
# Example PostgreSQL connection string:
# DATABASE_URL=postgres://postgres:password@localhost:5432/shahzod_studio
DATABASE_URL=

# ------------------------------------------------------------
# Telegram
# ------------------------------------------------------------
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Numeric Telegram ID of the admin who receives order notifications
TELEGRAM_ADMIN_ID=

# ------------------------------------------------------------
# Frontend URLs (used for CORS + links in bot notifications)
# ------------------------------------------------------------
# MINI_APP_URL is used for the bot's Web App buttons ("Открыть Shahzod Web Studio")
# and as a deep-link target (e.g. http://localhost:5173/calc for local dev).
# IMPORTANT: Telegram ONLY opens Mini Apps over HTTPS. For production set a
# public HTTPS URL, e.g. https://app.yourdomain.com (localhost works only for
# local testing, not in the Telegram client).
MINI_APP_URL=http://localhost:5173
# ADMIN_URL must also be a public HTTPS URL in production (used in bot notifs).
ADMIN_URL=http://localhost:5174

# Public base URL of this API (used to build links) — set the
# deployed HTTPS URL in production, e.g. https://api.yourdomain.com
PUBLIC_API_URL=http://localhost:4000

# ------------------------------------------------------------
# Admin panel credentials (initial login)
# ------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# JWT secret — use a long random string in production
JWT_SECRET=change-me-to-a-long-random-string

# ------------------------------------------------------------
# AI consultant (OpenAI-compatible)
# ------------------------------------------------------------
# Leave OPENAI_API_KEY empty to use the built-in fallback advisor.
# ------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ------------------------------------------------------------
# Optional: override the default AI system prompt (also editable
# live from the Admin Panel -> AI Settings)
# ------------------------------------------------------------
AI_SYSTEM_PROMPT=

# Dev-only: Telegram user used for the Mini App when no bot token is set
DEV_TELEGRAM_ID=12345

# ------------------------------------------------------------
# Vercel / production deployment
# ------------------------------------------------------------
# The backend deploys as a serverless function (api/index.ts, see vercel.json).
# Env vars are managed in Vercel Project Settings -> Environment Variables.
#
# REQUIRED for production (otherwise public /api routes return 401 and the
# bot notifications do not work):
#   TELEGRAM_BOT_TOKEN=<from @BotFather>
#   TELEGRAM_ADMIN_ID=<numeric id>
#
# Recommended:
#   NODE_ENV=production
#   JWT_SECRET=<long random string>
#   ADMIN_USERNAME=admin
#   ADMIN_PASSWORD=<strong password>
#   MINI_APP_URL=https://mini-app-sooty-five.vercel.app   (CORS + bot web_app buttons)
#   ADMIN_URL=https://admin-xxxx.vercel.app               (CORS + bot notification links)
#   PUBLIC_API_URL=https://mini-app-backend-three.vercel.app
#
# Optional (persistent storage instead of in-memory):
#   DB_TYPE=auto
#   DATABASE_URL=postgres://...  (Neon/Supabase, must be reachable from serverless)
#   OPENAI_API_KEY=...
#
# NOTE: TELEGRAM_BOT_TOKEN is checked at runtime. When it is set, authTelegram
# requires a valid Telegram initData in every protected request (secure). When
# it is NOT set, the dev-user fallback is used ONLY outside NODE_ENV=production.
