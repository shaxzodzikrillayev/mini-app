# ============================================================
#  Shahzod Web Studio — Mini App (frontend) environment
#  Copy to `.env` and set the backend API URL.
#  Only VITE_* variables are exposed to the browser.
#  NEVER put secret keys here — they would be visible to client.
# ============================================================

# Full backend API base URL (must include /api)
# Local dev:
VITE_API_URL=http://localhost:4000/api

# Production (deployed backend on Vercel):
# VITE_API_URL=https://mini-app-backend-three.vercel.app/api
#
# Vite loads env files per mode:
#   serve / dev     -> .env, .env.local
#   build (prod)    -> .env, .env.production   (override wins)
#
# On Vercel: set VITE_API_URL in Project Settings -> Environment Variables
# (Production). The Vercel env var wins over the .env files below.
# If VITE_API_URL is missing (or points to localhost) in a production build,
# the app throws a clear startup error instead of silently calling localhost.