# ============================================================
#  Shahzod Web Studio — Admin Panel (frontend) environment
#  Copy to `.env` and set the backend admin API URL.
#  Only VITE_* variables are exposed to the browser.
#  NEVER put secret keys here (e.g. do not put JWT_SECRET).
# ============================================================

# Full backend admin API base URL (must include /api/admin)
# Local dev:
VITE_API_URL=http://localhost:4000/api/admin

# Production example (use your real deployed HTTPS backend):
# VITE_API_URL=https://api.yourdomain.com/api/admin
